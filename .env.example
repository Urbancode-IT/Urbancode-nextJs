# Gmail SMTP via App Password (no Google Cloud Console required)
# Generate App Password: Google Account > Security > 2-Step Verification > App Passwords
GMAIL_SENDER=admin@urbancode.in
GMAIL_APP_PASSWORD=your_16_char_app_password_here
ENQUIRY_TO_EMAIL=admin@urbancode.in

# Home CMS admin (/home-admin) — defaults to LEAD_ADMIN_PASSWORD or UcHome@123
HOME_CMS_PASSWORD=UcHome@123

# Cloudinary Configuration
# Public cloud name required for frontend optimizations (e.g. streaming videos, responsive images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Private credentials for server-side operations (e.g. secure uploading, deleting assets)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
